# Variaveis da stack. No Portainer: Stacks > sua stack > Environment variables.
# Da para colar este arquivo inteiro no botao "Advanced mode" da secao.

# --- Obrigatorias -----------------------------------------------------------
ACME_EMAIL=suporte@dkdevs.com.br
API_DOMAIN=api.escrilex.app.br
FRONT_DOMAIN=escrilex.app.br
POSTGRES_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo

# --- Opcionais (os valores abaixo sao os defaults do compose) ----------------
POSTGRES_USER=escrilex
POSTGRES_DB=escrilex
OVERDUE_SCAN_EVERY_MINUTES=10
TEAMS_WEBHOOK_URL=
TRAEFIK_LOG_LEVEL=INFO
API_IMAGE=escrilex-api:latest
WEB_IMAGE=escrilex-web:latest
